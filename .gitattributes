# --- Line endings ----------------------------------------------------
# Everything text is LF. ESP-IDF's CMake, Kconfig and partition-table
# tooling and the shell entry points under tools/ all assume LF.
*               text=auto eol=lf
*.sh            text eol=lf
*.csv           text eol=lf
.envrc          text eol=lf
Kconfig*        text eol=lf
sdkconfig.*     text eol=lf
partitions.csv  text eol=lf

# --- dependencies.lock: never three-way merged ------------------------
# The IDF Component Manager lock file is generated (`idf.py reconfigure`)
# from main/idf_component.yml. A hand-resolved merge conflict in it is how
# silent component-version drift enters the build. Treat it as opaque:
# resolve the manifest, regenerate the lock, commit. Diffs are suppressed
# for the same reason — review the manifest change, not the solver output.
dependencies.lock  merge=binary -diff

# --- host/uv.lock: same reasoning as dependencies.lock -----------------
# Generated by `uv lock` from host/pyproject.toml. praat-parselmouth's exact
# version IS the bundled Praat version, so a hand-resolved conflict here would
# silently change which Praat every golden file was generated against.
host/uv.lock  merge=binary -diff

# --- host/web/package-lock.json: same reasoning as the two locks above --
# Generated by `npm install --package-lock-only` from host/web/package.json and
# installed by `npm ci`, never by hand. It is also the input of the fail-closed
# npm licence gate (ADR 0021 decision 4), so a hand-resolved merge conflict here
# would decide which licences are in the tree — the one review a three-way merge
# must never perform. Resolve package.json, regenerate the lock, commit.
host/web/package-lock.json  merge=binary -diff

# --- Binary documents and images --------------------------------------
# Vendor PDFs are kept verbatim; firmware images and golden vectors are
# opaque bytes. No EOL normalisation, no textual diff.
*.pdf   binary
*.bin   binary
*.elf   binary
*.png   binary
*.jpg   binary
*.wav   binary
*.f32   binary
*.npy   binary
*.ttf   binary
*.docx  binary
