{
  "analysis": {
    "averaging": "none",
    "db_reference": "dbfs_sine",
    "dc_blocker_hz": 20,
    "decimations": 0,
    "fft_size": 8192,
    "hold": "none",
    "interval_ms": 10,
    "resolution": {
      "bin_width_hz": 5.859375,
      "enbw_hz": 8.789062,
      "hop_samples": 480,
      "window_duration_ms": 170.666667
    },
    "sample_rate_hz": 48000,
    "smoothing": 0.0,
    "spectrum_type": "power_spectrum",
    "weighting": "Z",
    "window": {
      "coefficients": [
        0.5,
        0.5
      ],
      "coherent_gain": 0.5,
      "coherent_gain_db": -6.0206,
      "enbw_bins": 1.5,
      "form": "periodic",
      "name": "hann"
    }
  },
  "description": "Offline comparison of a recorded take against an isolated reference vocal stem: LTAS, SPR and an f0 overlay after DTW alignment. Never runs on the watch.",
  "display": {
    "db_ceiling_dbfs": 0,
    "db_floor_dbfs": -100,
    "freq_max_hz": 16000,
    "freq_min_hz": 60,
    "freq_scale": "log",
    "overlays": [
      "stem_f0",
      "dtw_path",
      "ltas",
      "spr"
    ]
  },
  "guidance": "Both signals must come from the same take geometry to be comparable; stem separation artefacts propagate into f0 and formant tracks, so validate against the full mix too.",
  "host": {
    "align": "dtw_chroma",
    "reference": "stem",
    "separation": "demucs_htdemucs_ft"
  },
  "id": "stem_analysis",
  "mic_eq": {
    "mode": "none"
  },
  "name": "Stem analysis (host only)",
  "provisional": [
    "/analysis/dc_blocker_hz",
    "/display/db_floor_dbfs"
  ],
  "schema_version": "1.0.0",
  "targets": [
    "host"
  ]
}
