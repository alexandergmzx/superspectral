#
# shellcheck shell=bash
#   A directive, not a shebang: direnv SOURCES this file, it does not execute it, so a
#   shebang would be misleading. The directive tells shellcheck which dialect to check
#   (SC2148) without changing how direnv treats the file.
#
# Super Spectral — the ESP-IDF pin, in plain sight. (direnv; `direnv allow` once.)
#
# ESP-IDF v6.0.2 (tag, released 2026-06-29; Service to 2027-03-20, EOL 2028-09-20;
# verified 2026-08-20). The commit SHA and the full tool inventory live in
# docs/devenv/env.lock.md (regenerated by tools/env-lock.sh). Rationale: ADR 0001,
# docs/adr/0001-toolchain-esp-idf-v6-pinned-environment.md. Setup: docs/devenv/setup.md.
#
# Why direnv and not `.bashrc`/an alias: export.sh prepends to PATH and never
# unwinds; direnv snapshots the environment on entry and RESTORES it on exit, so
# two IDF versions can coexist on one machine with zero cross-contamination.
# ----------------------------------------------------------------------------
IDF_VERSION_EXPECTED="v6.0.2"
export IDF_PATH="$HOME/esp/idf/$IDF_VERSION_EXPECTED"          # full recursive clone at the tag
export IDF_TOOLS_PATH="$HOME/esp/tools/$IDF_VERSION_EXPECTED"  # one tools root per IDF minor

# Strip ROS 2 Jazzy leakage (host audit 2026-08-20: ~/.bashrc sources
# /opt/ros/jazzy/setup.bash unconditionally). PYTHONPATH lands on sys.path BEFORE
# the venv's site-packages even with include-system-site-packages=false,
# shadowing constraint-pinned yaml/lark/packaging; CMAKE_PREFIX_PATH is read by
# every find_package(); LD_LIBRARY_PATH can make openocd/esptool/gdb load the
# wrong libssl/libusb. Pitfalls A1/A2 in docs/devenv/pitfalls.md.
unset PYTHONPATH
unset CMAKE_PREFIX_PATH
unset LD_LIBRARY_PATH
unset AMENT_PREFIX_PATH

# Keep /usr/bin ahead of /opt/st: STM32CubeCLT shadows cmake and ninja on this
# host (pitfall A15). Both satisfy IDF's >=3.22, but do not depend on ST's layout.
export PATH="/usr/bin:$PATH"

# The EIM activation script on this host sets IDF_COMPONENT_LOCAL_STORAGE_URL to
# a PARTIAL offline mirror (~/.espressif/tools/components). If it leaks in, the
# component manager short-circuits registry resolution at the first storage
# that has any version (lvgl 9.4.0 instead of 9.5.0, no esp-dsp at all).
# Pitfall B8. CI, which has no mirror, is the arbiter of dependencies.lock.
unset IDF_COMPONENT_LOCAL_STORAGE_URL

export IDF_CCACHE_ENABLE=1            # idf.py --ccache by default
export ESPPORT="${ESPPORT:-/dev/ttyTWATCH}"   # udev SYMLINK from docs/devenv/setup.md §4
export ESPBAUD="${ESPBAUD:-460800}"

if [ ! -f "$IDF_PATH/export.sh" ]; then
  echo "direnv: ESP-IDF $IDF_VERSION_EXPECTED not found at $IDF_PATH."
  echo "direnv: follow docs/devenv/setup.md (roadmap phase E1) — nothing was activated."
else
  # export.sh is not written for `set -u`; relax while sourcing.
  set +u
  # shellcheck disable=SC1091
  . "$IDF_PATH/export.sh" > /dev/null
  set -u

  # Guard against the wrong tree being active (pitfall A4).
  if ! idf.py --version 2>/dev/null | grep -q "$IDF_VERSION_EXPECTED"; then
    echo "WARNING: idf.py is not $IDF_VERSION_EXPECTED — check IDF_PATH ($IDF_PATH)."
  fi
fi
# ----------------------------------------------------------------------------
